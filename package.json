{
  "name": "antybrowser",
  "version": "1.0.0",
  "description": "Portable Antidetect Browser with Chromium, independent profiles and stealth fingerprints",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "tsc -p tsconfig.json && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:portable": "npm run build && electron-builder --win portable --x64",
    "test": "node dist-tests/tests/persistence.test.js && node dist-tests/tests/portability.test.js && node dist-tests/tests/proxy.test.js && node dist-tests/tests/bridge.test.js && node dist-tests/tests/tabs.test.js && node dist-tests/tests/firefox.test.js"
  },
  "build": {
    "appId": "com.antybrowser.portable",
    "productName": "AntyBrowser",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "AntyBrowser.exe"
    }
  },
  "keywords": [
    "antidetect",
    "browser",
    "portable",
    "chromium",
    "fingerprint",
    "stealth",
    "playwright"
  ],
  "author": "AntyBrowser Team",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socks-proxy-agent": "^10.1.0",
    "sql.js": "^1.15.1",
    "uuid": "^14.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
